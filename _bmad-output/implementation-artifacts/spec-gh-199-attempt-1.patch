+        }
+    }.joinToString(". ")
+
+@Composable
+internal fun ProblemTag(
+    number: Int,
+    focused: Boolean,
+    tag: String,
+    modifier: Modifier = Modifier,
+    diameter: Dp = 24.dp,
+) {
+    val tokens = RubikTheme.tokens
+    Box(
+        modifier
+            .requiredSize(diameter)
+            .background(if (focused) tokens.stickerHighlight else tokens.cubieBody, CircleShape)
+            .border(1.dp, tokens.stickerHighlight, CircleShape)
+            .clearAndSetSemantics {
+                testTag = tag
+                this[StickerProblemFocusedKey] = focused
+            },
+        contentAlignment = Alignment.Center,
+    ) {
+        StickerLabel(number.toString(), if (focused) tokens.cubieBody else tokens.stickerHighlight, diameter * 0.8f)
+    }
