+                        onDragStart = { start ->
+                            dragging =
+                                latest.indices.minByOrNull { i ->
+                                    val p = latest[i]
+                                    hypot(p[0] * size.width - start.x, p[1] * size.height - start.y).toDouble()
+                                } ?: -1
+                        },
+                        onDragEnd = { dragging = -1 },
+                    ) { change, amount ->
+                        change.consume()
+                        if (dragging >= 0) onMove(dragging, amount.x / size.width.toDouble(), amount.y / size.height.toDouble())
+                    }
