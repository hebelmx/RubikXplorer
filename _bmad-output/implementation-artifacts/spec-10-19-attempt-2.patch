+    dev.cubentia.domain.recognition.CornerGroupManifest(
+        pipeline = dev.cubentia.domain.recognition.CornerFixturePaths.PIPELINE_10_19,
+        lightDirection = direction,
+        device = device,
+        cube = cube.trim(),
+        light = light.trim(),
+        torch = torch,
