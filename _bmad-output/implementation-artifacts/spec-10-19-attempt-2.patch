+        val top = stickers(Color.WHITE)
+        val left = stickers(Color.GREEN)
+        val right = stickers(Color.RED)
+        val calibrated = SideLight.checkLab(top, left, right, saved)
+        assertEquals(SideLight.Mode.CALIBRATED, calibrated.mode)
