{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle.schema.json",
  "title": "Content bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stages", "algorithms"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "stages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^stages/stage-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*\\.json$" }
    },
    "algorithms": {
      "type": "array",
      "items": { "type": "string", "pattern": "^algorithms/[a-z0-9-]+\\.json$" }
    },
    "twoLook": {
      "type": "array",
      "items": { "type": "string", "pattern": "^two-look/stage-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*\\.json$" }
    }
  }
}
