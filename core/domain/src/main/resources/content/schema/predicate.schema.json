{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "predicate.schema.json",
  "title": "Predicate",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate"],
      "properties": {
        "predicate": { "const": "white-cross-solved" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate"],
      "properties": {
        "predicate": { "const": "white-corners-solved" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "moves"],
      "properties": {
        "predicate": { "const": "state-reached" },
        "moves": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "piece"],
      "properties": {
        "predicate": { "const": "white-piece-solved" },
        "piece": {
          "type": "string",
          "enum": [
            "white-green", "white-red", "white-blue", "white-orange",
            "white-green-red", "white-red-blue", "white-blue-orange", "white-orange-green"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate"],
      "properties": {
        "predicate": { "const": "nothing" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "predicates"],
      "properties": {
        "predicate": { "const": "allOf" },
        "predicates": { "type": "array", "minItems": 1, "items": { "$ref": "#" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "predicates"],
      "properties": {
        "predicate": { "const": "anyOf" },
        "predicates": { "type": "array", "minItems": 1, "items": { "$ref": "#" } }
      }
    }
  ]
}
