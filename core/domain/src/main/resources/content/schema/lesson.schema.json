{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "stageId", "prerequisites", "objective", "entryState", "demonstration",
    "learnerAction", "completion", "preserve", "recovery", "steps"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/lessonId" },
    "stageId": { "type": "string", "pattern": "^stage-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/lessonId" } },
    "objective": { "$ref": "#/$defs/textKey" },
    "entryState": { "type": "string", "pattern": "^[WYGBRO]{54}$" },
    "demonstration": { "$ref": "#/$defs/notation" },
    "learnerAction": { "$ref": "#/$defs/textKey" },
    "completion": { "$ref": "predicate.schema.json" },
    "preserve": { "$ref": "predicate.schema.json" },
    "recovery": { "type": "string", "pattern": "^recovery-[a-z0-9]+(-[a-z0-9]+)*$" },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "lessonId": { "type": "string", "pattern": "^lesson-[0-9]{2}-[0-9]{2}$" },
    "textKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9-]+\\.[a-z][a-z0-9-]*(\\.[0-9]+)?$" },
    "notation": { "type": "string" },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "preserve", "watch", "notice", "moves"],
      "properties": {
        "goal": { "$ref": "#/$defs/textKey" },
        "preserve": { "$ref": "#/$defs/textKey" },
        "watch": { "$ref": "#/$defs/textKey" },
        "notice": { "$ref": "#/$defs/textKey" },
        "moves": { "$ref": "#/$defs/notation" }
      }
    }
  }
}
