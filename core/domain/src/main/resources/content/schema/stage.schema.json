{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage.schema.json",
  "title": "Stage",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "lessons"],
  "properties": {
    "id": { "type": "string", "pattern": "^stage-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "$ref": "lesson.schema.json#/$defs/textKey" },
    "lessons": { "type": "array", "items": { "$ref": "lesson.schema.json" } }
  }
}
