<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- AD-13 offline: litert-api declares these for Play AI-pack downloads, which Cubentia never uses (the model is
         a bundled asset). ManifestPolicy rejects them in every variant. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
</manifest>
